# Copiez ce fichier en .env.local, dans ce dossier web/.
# L'adresse de votre serveur pendant le développement (npm run dev:web).
# Changez le port si votre serveur n'est pas sur 3000 (module 5).
# Une fois construite (npm run build), l'interface est servie par le serveur, sur
# la même adresse : elle appelle /api, sans réglage. Voir DEPLOIEMENT.md.
VITE_ADRESSE_API=http://localhost:3000
