# Copiez ce fichier en .env, puis remplacez les valeurs par les vôtres.
# Le fichier .env n'est jamais envoyé sur GitHub : il est dans .gitignore.

# L'adresse de votre base PostgreSQL locale, créée au module 2.
# Forme : postgres://utilisateur:mot-de-passe@localhost:5432/nom-de-la-base
DATABASE_URL=postgres://postgres:postgres@localhost:5432/clone_shopify

# Une seconde base, créée au module 2, où les vérifications écrivent leurs
# boutiques et leurs commandes d'essai. Votre application reste ainsi propre.
DATABASE_URL_VERIFICATION=postgres://postgres:postgres@localhost:5432/clone_shopify_verification

# L'adresse de votre interface, autorisée à appeler l'API (module 5).
# En ligne, c'est l'adresse unique de votre application (module 15).
ORIGINE_INTERFACE=http://localhost:5173

# Le port de votre serveur. Si une autre application occupe déjà le 3000,
# choisissez-en un autre, par exemple 3010, et changez aussi ADRESSE_API
# ci-dessous et VITE_ADRESSE_API dans web/.env.local (module 5).
PORT=3000

# L'adresse publique de votre API (modules 6 et 10) : les photos du stockage
# simulé et le prestataire de paiement simulé s'en servent.
ADRESSE_API=http://localhost:3000

# Les secrets de votre serveur. En local, n'importe quelle longue suite de
# caractères convient; en production, l'hébergeur fournit les vraies valeurs.
SECRET_STOCKAGE=a-remplacer-par-une-longue-suite-de-caracteres
SECRET_WEBHOOK=a-remplacer-par-une-autre-longue-suite-de-caracteres

# L'adresse de votre application en ligne (module 15). L'interface et l'API
# sont servies par le même service, sur une seule adresse : donnez la même valeur
# aux deux lignes. Elles permettent de lancer la vérification du module 15, et
# celles qui la suivent, sur votre machine. Retirez le # une fois en ligne.
# DEPLOYMENT_URL=https://votre-application.onrender.com
# INTERFACE_URL=https://votre-application.onrender.com

# Hébergement tout-en-un : PostgreSQL local; voir DEPLOIEMENT.md.
# LOCAL_DATABASE=1
# DATA_DIR=.data
# LOCAL_PG_PORT=54329
