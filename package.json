{
  "name": "clone-shopify",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "academie": "node academie/run.mjs",
    "dev": "tsx watch --env-file-if-exists=.env src/serveur.ts",
    "dev:web": "npm run dev --prefix web",
    "web:install": "npm install --prefix web",
    "migrate": "node --env-file-if-exists=.env scripts/migrer.mjs",
    "test": "node scripts/tests.mjs",
    "typecheck": "tsc --noEmit",
    "start": "node --env-file-if-exists=.env scripts/demarrer.mjs",
    "build": "npm run build --prefix web",
    "test:hosting": "node --import tsx --test scripts/hebergement.test.ts scripts/postgres.test.mjs scripts/processus.test.mjs"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/pg": "^8.23.1",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  },
  "dependencies": {
    "@hono/node-server": "^1.19.0",
    "hono": "^4.9.0",
    "pg": "^8.23.0",
    "tsx": "^4.20.0"
  },
  "academieHosting": {
    "postgis": false
  }
}
